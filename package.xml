<package format="3">
  <name>lidar_control</name>
  <version>0.1.0</version>
  <description>Integrated control and Foxglove visualization for TG30 and GS2 LiDARs on Raspberry Pi 5</description>
  <maintainer email="studKo@users.noreply.github.com">studKo</maintainer>
  <license>MIT</license>
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
  
</package>